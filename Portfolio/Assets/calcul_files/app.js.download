
function calculate(btnValue){
    let calInp = document.getElementById("input")
    if(btnValue == '='){
     caconsole.log(calInp.value)
    }
    else if(btnValue ==  'AC'){
        calInp.value = ""
    }
    else if(btnValue == 'Del'){
        calInp.value = calInp.value.slice(0,-1)
    }
    
    else{
        calInp.value += btnValue
    }
    
}